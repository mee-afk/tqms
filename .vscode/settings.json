{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "[typescript]": { "editor.defaultFormatter": "vscode.typescript-language-features", "editor.formatOnSave": true },
  "[typescriptreact]": { "editor.defaultFormatter": "vscode.typescript-language-features", "editor.formatOnSave": true },
  "[css]": { "editor.defaultFormatter": "vscode.css-language-features", "editor.formatOnSave": true }
}
